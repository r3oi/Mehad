{
 "take": "full_sterling_light.mp3",
 "lines": [
  {
   "i": 1,
   "t0": 1.0,
   "t1": 3.41,
   "text": "كل شيء كبير... بدأ بفكرة."
  },
  {
   "i": 2,
   "t0": 5.5,
   "t1": 7.43,
   "text": "ومهاد... بدأت بفكرة."
  },
  {
   "i": 3,
   "t0": 9.3,
   "t1": 13.42,
   "text": "فكرة إن التعليم... يكون أقرب. أسهل. وأوسع."
  },
  {
   "i": 4,
   "t0": 13.8,
   "t1": 16.73,
   "text": "خلال الشهور اللي راحت... ما كان الطريق سهل."
  },
  {
   "i": 5,
   "t0": 18.0,
   "t1": 21.66,
   "text": "اشتغلنا... وجرّبنا... وغلطنا... وعدّلنا."
  },
  {
   "i": 6,
   "t0": 22.3,
   "t1": 25.78,
   "text": "مرات وقفنا عند مشكلة... ومرات رجعنا من البداية."
  },
  {
   "i": 7,
   "t0": 26.5,
   "t1": 29.3,
   "text": "بس كل مرة... كان عندنا سبب نكمل."
  },
  {
   "i": 8,
   "t0": 36.0,
   "t1": 39.92,
   "text": "وفي يوم نحتفل فيه بوطن... علّمنا إن الطموح ما له سقف."
  },
  {
   "i": 9,
   "t0": 43.5,
   "t1": 44.92,
   "text": "نحتفل بخطوة جديدة..."
  },
  {
   "i": 10,
   "t0": 46.0,
   "t1": 48.07,
   "text": "خطوة اسمها... مهاد."
  },
  {
   "i": 11,
   "t0": 53.6,
   "t1": 55.88,
   "text": "اليوم... مهاد مو مجرد فكرة."
  },
  {
   "i": 12,
   "t0": 56.8,
   "t1": 58.91,
   "text": "اليوم... مهاد صارت منصة."
  },
  {
   "i": 13,
   "t0": 59.5,
   "t1": 61.56,
   "text": "ومن هنا... تبدأ الحكاية."
  },
  {
   "i": 14,
   "t0": 62.3,
   "t1": 63.82,
   "text": "طموحنا أكبر من منصة."
  },
  {
   "i": 15,
   "t0": 64.4,
   "t1": 66.94,
   "text": "طموحنا إننا نقرّب التعليم... من كل طالب."
  },
  {
   "i": 16,
   "t0": 67.52,
   "t1": 72.75,
   "text": "ونعطي المعلم مساحة أكبر... يعلّم، ويطوّر، ويصنع أثر."
  },
  {
   "i": 17,
   "t0": 72.9,
   "t1": 76.2,
   "text": "ونبني تجربة... تخلي التعليم أقرب للناس."
  },
  {
   "i": 18,
   "t0": 76.8,
   "t1": 78.72,
   "text": "وهذي... بس البداية."
  },
  {
   "i": 19,
   "t0": 80.3,
   "t1": 83.12,
   "text": "من السعودية... وبطموح ما يعرف حدود."
  },
  {
   "i": 20,
   "t0": 84.3,
   "t1": 84.9,
   "text": "مهاد."
  }
 ]
}