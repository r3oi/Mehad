# Leave MYFATOORAH_TOKEN empty to run in preview mode (sample data, no charges).
MYFATOORAH_TOKEN=

# Test environment (default)
MYFATOORAH_API_URL=https://apitest.myfatoorah.com
MYFATOORAH_SCRIPT_URL=https://demo.myfatoorah.com/payment/v1/session.js

# Saudi Arabia live
# MYFATOORAH_API_URL=https://api-sa.myfatoorah.com
# MYFATOORAH_SCRIPT_URL=https://sa.myfatoorah.com/payment/v1/session.js

# Public HTTPS address of the site; MyFatoorah sends customers back to $PUBLIC_URL/payment/callback
PUBLIC_URL=http://localhost:3000
PORT=3000
